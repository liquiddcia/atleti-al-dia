{
  "crons": [
    {
      "path": "/api/actualizar",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/actualizar.js": {
      "maxDuration": 60
    },
    "api/partido.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/noticia/:slug", "destination": "/api/noticia?slug=:slug" },
    { "source": "/noticias", "destination": "/api/archivo" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
